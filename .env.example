# Environment roles (planner, user simulator, monitor, judge, seed audit).
OPENAI_API_KEY=

# Claude responders.
ANTHROPIC_API_KEY=

# A responder served from an OpenAI-compatible endpoint (--responder-base-url),
# e.g. an OpenRouter key or any value for a local vLLM server.
RESPONDER_API_KEY=

# Hugging Face token with access to the gated allenai/WildChat-1M dataset,
# needed only to build seed pools (docs/seeds.md).
HF_TOKEN=
